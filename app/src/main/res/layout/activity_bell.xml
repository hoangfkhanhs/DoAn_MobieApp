<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F3F5FC"
    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHeader"
        android:layout_width="0dp"
        android:layout_height="123dp"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"

        app:cardBackgroundColor="#30377F"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"

        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- LOGO -->


            <!-- TIÊU ĐỀ -->

            <TextView
                android:id="@+id/tvTieuDe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="20dp"
                android:layout_marginTop="42dp"

                android:text="Thông báo"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- SỐ LƯỢNG -->

            <TextView
                android:id="@+id/tvSoThongBao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="8dp"
                android:layout_marginTop="45dp"

                android:gravity="center"

                android:text="4"
                android:textColor="#30377F"
                android:textSize="10sp"
                android:textStyle="bold"

                app:layout_constraintStart_toEndOf="@id/tvTieuDe"
                app:layout_constraintTop_toTopOf="parent" />


            <!-- TẮT THÔNG BÁO -->

            <TextView
                android:id="@+id/tvTatThongBao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="20dp"
                android:layout_marginBottom="16dp"

                android:text="Tắt thông báo"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- SWITCH -->

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchThongBao"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:checked="false"
                android:gravity="center"
                app:thumbTint="#FFFFFF"
                app:trackTint="#8D92C5"
                app:layout_constraintStart_toEndOf="@id/tvTatThongBao"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- THANH LỌC -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/filterContainer"

        android:layout_width="0dp"
        android:layout_height="42dp"

        android:layout_marginStart="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="18dp"

        android:gravity="center_vertical"
        android:orientation="horizontal"

        app:layout_constraintTop_toBottomOf="@id/cardHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- TẤT CẢ -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnTatCa"
            android:layout_width="0dp"
            android:layout_height="36dp"

            android:layout_marginEnd="6dp"
            android:layout_weight="1"

            app:cardBackgroundColor="#30377F"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:text="Tất cả"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>


        <!-- CHƯA ĐỌC -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnChuaDoc"
            android:layout_width="0dp"
            android:layout_height="36dp"

            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:text="Chưa đọc"
                android:textColor="#30377F"
                android:textSize="10sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>


        <!-- LỊCH -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnLich"

            android:layout_width="0dp"
            android:layout_height="36dp"

            android:layout_marginStart="6dp"
            android:layout_weight="1"

            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"

            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"

                android:text="Lịch"
                android:textColor="#30377F"
                android:textSize="10sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- ĐÁNH DẤU ĐÃ ĐỌC -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/btnDanhDau"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginEnd="20dp"

        android:text="Đánh dấu tất cả đã đọc"
        android:textColor="#30377F"
        android:textSize="9sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/filterContainer"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- DANH SÁCH THÔNG BÁO -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollThongBao"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="15dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:fillViewport="true"
        android:scrollbars="none"

        app:layout_constraintTop_toBottomOf="@id/btnDanhDau"
        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ===================================================== -->
        <!-- DANH SÁCH THÔNG BÁO -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/layoutDanhSachThongBao"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">


            <!-- ================================================= -->
            <!-- THÔNG BÁO 1 - ĐÃ XÁC NHẬN -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notification1"

                android:layout_width="match_parent"
                android:layout_height="82dp"

                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- THANH MÀU XANH BÊN TRÁI -->

                    <View
                        android:layout_width="4dp"
                        android:layout_height="0dp"

                        android:background="#30377F"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <!-- AVATAR -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatar1"

                        android:layout_width="50dp"
                        android:layout_height="50dp"

                        android:layout_marginStart="12dp"

                        app:cardBackgroundColor="#F1F2FB"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"

                            android:layout_gravity="center"

                            android:contentDescription="Người dùng"

                            android:src="@drawable/ic_user"
                            app:tint="#30377F" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- TÊN -->

                    <TextView
                        android:id="@+id/tvCafe1"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="45dp"

                        android:text="Cafe americano"

                        android:textColor="#30377F"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        app:layout_constraintStart_toEndOf="@id/avatar1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar1" />


                    <!-- THỜI GIAN -->

                    <TextView
                        android:id="@+id/tvTime1"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="7:00 • 28/09/2026"

                        android:textColor="#999999"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe1"
                        app:layout_constraintTop_toBottomOf="@id/tvCafe1" />


                    <!-- NỘI DUNG -->

                    <TextView
                        android:id="@+id/tvContent1"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="40dp"

                        android:maxLines="2"
                        android:ellipsize="end"

                        android:text="Bạn đã được xác nhận công việc pha chế tại Cafe americano."

                        android:textColor="#666666"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTime1" />


                    <!-- TRẠNG THÁI THÀNH CÔNG -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"

                        app:cardBackgroundColor="#4CAF50"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:text="✓"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- THÔNG BÁO 2 - TỪ CHỐI -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notification2"

                android:layout_width="match_parent"
                android:layout_height="82dp"

                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- THANH ĐỎ -->

                    <View
                        android:layout_width="4dp"
                        android:layout_height="0dp"

                        android:background="#E53935"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <!-- AVATAR -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatar2"

                        android:layout_width="50dp"
                        android:layout_height="50dp"

                        android:layout_marginStart="12dp"

                        app:cardBackgroundColor="#FFF1F1"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_user"
                            app:tint="#E53935" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- TÊN -->

                    <TextView
                        android:id="@+id/tvCafe2"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="45dp"

                        android:text="Cafe americano"

                        android:textColor="#30377F"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        app:layout_constraintStart_toEndOf="@id/avatar2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar2" />


                    <!-- THỜI GIAN -->

                    <TextView
                        android:id="@+id/tvTime2"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="7:00 • 12/09/2026"

                        android:textColor="#999999"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe2"
                        app:layout_constraintTop_toBottomOf="@id/tvCafe2" />


                    <!-- NỘI DUNG -->

                    <TextView
                        android:id="@+id/tvContent2"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="40dp"

                        android:maxLines="2"
                        android:ellipsize="end"

                        android:text="Đơn đăng ký công việc pha chế của bạn đã bị từ chối."

                        android:textColor="#666666"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTime2" />


                    <!-- TRẠNG THÁI TỪ CHỐI -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"

                        app:cardBackgroundColor="#E53935"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:text="×"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- THÔNG BÁO 3 - NHẮC LỊCH -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notification3"

                android:layout_width="match_parent"
                android:layout_height="82dp"

                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- THANH CAM -->

                    <View
                        android:layout_width="4dp"
                        android:layout_height="0dp"

                        android:background="#FF9800"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <!-- AVATAR -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatar3"

                        android:layout_width="50dp"
                        android:layout_height="50dp"

                        android:layout_marginStart="12dp"

                        app:cardBackgroundColor="#FFF6E8"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <ImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_calendar"
                            app:tint="#FF9800" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- TIÊU ĐỀ -->

                    <TextView
                        android:id="@+id/tvCafe3"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="45dp"

                        android:text="Lịch làm việc"

                        android:textColor="#30377F"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        app:layout_constraintStart_toEndOf="@id/avatar3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar3" />


                    <!-- THỜI GIAN -->

                    <TextView
                        android:id="@+id/tvTime3"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="6:30 • 29/09/2026"

                        android:textColor="#999999"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe3"
                        app:layout_constraintTop_toBottomOf="@id/tvCafe3" />


                    <!-- NỘI DUNG -->

                    <TextView
                        android:id="@+id/tvContent3"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="40dp"

                        android:maxLines="2"
                        android:ellipsize="end"

                        android:text="Bạn có lịch làm việc tại Cafe americano vào lúc 7:00."

                        android:textColor="#666666"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTime3" />


                    <!-- TRẠNG THÁI -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"

                        app:cardBackgroundColor="#FF9800"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_calendar"
                            app:tint="#FFFFFF" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- THÔNG BÁO 4 - THÔNG TIN -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notification4"

                android:layout_width="match_parent"
                android:layout_height="82dp"

                android:layout_marginBottom="20dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- THANH XANH -->

                    <View
                        android:layout_width="4dp"
                        android:layout_height="0dp"

                        android:background="#30377F"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                    <!-- AVATAR -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/avatar4"

                        android:layout_width="50dp"
                        android:layout_height="50dp"

                        android:layout_marginStart="12dp"

                        app:cardBackgroundColor="#F1F2FB"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_user"
                            app:tint="#30377F" />

                    </com.google.android.material.card.MaterialCardView>


                    <!-- TIÊU ĐỀ -->

                    <TextView
                        android:id="@+id/tvCafe4"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="45dp"

                        android:text="Cafe americano"

                        android:textColor="#30377F"
                        android:textSize="13sp"
                        android:textStyle="bold"

                        app:layout_constraintStart_toEndOf="@id/avatar4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/avatar4" />


                    <!-- THỜI GIAN -->

                    <TextView
                        android:id="@+id/tvTime4"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="2dp"

                        android:text="8:00 • 30/09/2026"

                        android:textColor="#999999"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe4"
                        app:layout_constraintTop_toBottomOf="@id/tvCafe4" />


                    <!-- NỘI DUNG -->

                    <TextView
                        android:id="@+id/tvContent4"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="3dp"
                        android:layout_marginEnd="40dp"

                        android:maxLines="2"
                        android:ellipsize="end"

                        android:text="Bạn có một thông báo mới từ nhà tuyển dụng."

                        android:textColor="#666666"
                        android:textSize="9sp"

                        app:layout_constraintStart_toStartOf="@id/tvCafe4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvTime4" />


                    <!-- TRẠNG THÁI -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="27dp"
                        android:layout_height="27dp"

                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"

                        app:cardBackgroundColor="#30377F"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"

                            android:layout_gravity="center"

                            android:src="@drawable/ic_bell"
                            app:tint="#FFFFFF" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>
    <!-- ===================================================== -->
    <!-- THANH ĐIỀU HƯỚNG DƯỚI -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="58dp"

        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="9dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"

        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">


            <!-- ================================================= -->
            <!-- HOME -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgHomeNormal"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="Trang chủ"
                    android:src="@drawable/ic_house"
                    app:tint="#30377F" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- THÔNG BÁO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navNotification"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Khoảng trống dành cho icon nổi -->

                <Space
                    android:layout_width="1dp"
                    android:layout_height="25dp" />

                <!-- CHỮ THÔNG BÁO -->

                <TextView
                    android:id="@+id/tvNotification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Thông báo"
                    android:textColor="#30377F"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- NHÓM -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navGroup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgGroup"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:contentDescription="Nhóm"
                    android:src="@drawable/ic_users"
                    app:tint="#30377F" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CÁ NHÂN -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/navPerson"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgPerson"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:contentDescription="Cá nhân"
                    android:src="@drawable/ic_user"
                    app:tint="#30377F" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- ICON THÔNG BÁO NỔI -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/notificationFloating"
        android:layout_width="0dp"
        android:layout_height="70dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:elevation="30dp"
        android:translationZ="30dp"

        android:translationY="-25dp"

        app:layout_constraintWidth_percent="0.25"

        app:layout_constraintStart_toStartOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="@id/bottomNavigation"

        app:layout_constraintHorizontal_bias="0.3333"

        app:layout_constraintBottom_toBottomOf="@id/bottomNavigation">


        <!-- ================================================= -->
        <!-- VÒNG NGOÀI -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"

            app:cardBackgroundColor="#F3F5FC"
            app:cardCornerRadius="31dp"
            app:cardElevation="0dp"

            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp" />


        <!-- ================================================= -->
        <!-- VÒNG XANH -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"

            android:elevation="30dp"
            android:translationZ="30dp"

            app:cardBackgroundColor="#30377F"
            app:cardCornerRadius="23dp"
            app:cardElevation="12dp"

            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgNotificationFloating"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:contentDescription="Thông báo"
                android:src="@drawable/ic_bell"
                app:tint="#FFFFFF" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>