<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F3F5FC"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- HEADER XANH FULL WIDTH -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerProfile"

        android:layout_width="0dp"
        android:layout_height="250dp"

        app:cardBackgroundColor="#30377F"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"

        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTrangCaNhan"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="27dp"

                android:text="Trang cá nhân"

                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- ================================================= -->
            <!-- NÚT SỬA THÔNG TIN -->
            <!-- ================================================= -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuaThongTin"
                android:layout_width="105dp"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:padding="0dp"
                android:text="Sửa thông tin"
                android:textAllCaps="false"
                android:textColor="#30377F"
                android:textSize="10sp"
                android:textStyle="bold"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="18dp"
                app:elevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvTrangCaNhan"
                app:layout_constraintEnd_toStartOf="@id/btnDoiMatKhau"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDoiMatKhau"
                android:layout_width="105dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="18dp"
                android:padding="0dp"
                android:text="Đổi mật khẩu"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:backgroundTint="@android:color/transparent"
                app:cornerRadius="18dp"
                app:elevation="0dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/tvTrangCaNhan"
                app:layout_constraintStart_toEndOf="@id/btnSuaThongTin"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>



    <!-- ===================================================== -->
    <!-- AVATAR -->
    <!-- ĐẶT CHÍNH GIỮA VÀ CHỒNG LÊN ĐÁY HEADER -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAvatar"

        android:layout_width="128dp"
        android:layout_height="128dp"

        android:layout_marginTop="145dp"

        android:elevation="20dp"
        android:translationZ="20dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="64dp"
        app:cardElevation="8dp"

        app:strokeColor="#FFFFFF"
        app:strokeWidth="5dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <ImageView
            android:id="@+id/imgAvatar"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:padding="9dp"

            android:contentDescription="Ảnh đại diện"

            android:scaleType="centerInside"

            android:src="@drawable/ic_user"

            app:tint="#000000" />

    </com.google.android.material.card.MaterialCardView>



    <!-- ===================================================== -->
    <!-- NÚT ĐỔI AVATAR -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btnDoiAvatar"

        android:layout_width="44dp"
        android:layout_height="44dp"

        android:layout_marginStart="-22dp"
        android:layout_marginBottom="2dp"

        android:elevation="30dp"
        android:translationZ="30dp"

        app:cardBackgroundColor="#D9E0E8"
        app:cardCornerRadius="22dp"
        app:cardElevation="6dp"

        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintStart_toEndOf="@id/cardAvatar"
        app:layout_constraintBottom_toBottomOf="@id/cardAvatar">
        <FrameLayout
            android:id="@+id/layoutDoiAnh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Đổi"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>



    <!-- ===================================================== -->
    <!-- HỌ TÊN -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvHoTen"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"

        android:gravity="center"

        android:text="Thêm thông tin"

        android:textColor="#111111"
        android:textSize="22sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/cardAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- ===================================================== -->
    <!-- NGÀY SINH -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvNgaySinh"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:text="Thêm thông tin"

        android:textColor="#444444"
        android:textSize="13sp"

        app:layout_constraintTop_toBottomOf="@id/tvHoTen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



    <!-- ===================================================== -->
    <!-- CARD THÔNG TIN -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardThongTin"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="21dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="21dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="1dp"

        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintTop_toBottomOf="@id/tvNgaySinh"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:padding="14dp">


            <!-- ================================================= -->
            <!-- GIỚI THIỆU -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Giới thiệu"

                android:textColor="#30377F"
                android:textSize="13sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvGioiThieu"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"
                android:text="Thêm thông tin"
                android:textColor="#333333"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- ĐƯỜNG KẺ -->
            <!-- ================================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"

                android:background="#E8E8E8" />


            <!-- ================================================= -->
            <!-- ĐỊA CHỈ -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Địa chỉ"

                android:textColor="#30377F"
                android:textSize="13sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvDiaChi"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"
                android:text="Thêm thông tin"
                android:textColor="#333333"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- ĐƯỜNG KẺ -->
            <!-- ================================================= -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"

                android:background="#E8E8E8" />


            <!-- ================================================= -->
            <!-- THÔNG TIN LIÊN HỆ -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Thông tin liên hệ"

                android:textColor="#30377F"
                android:textSize="13sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvSDT"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"
                android:text="Thêm thông tin"
                android:textColor="#333333"
                android:textSize="12sp" />


            <TextView
                android:id="@+id/tvEmail"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:maxLines="1"
                android:ellipsize="end"
                android:text="Thêm thông tin"
                android:textColor="#333333"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- THANH ĐIỀU HƯỚNG DƯỚI -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"

        android:layout_width="0dp"
        android:layout_height="58dp"

        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="9dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"

        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="horizontal"
            android:gravity="center"

            android:weightSum="4">


            <!-- ================================================= -->
            <!-- HOME -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/navHome"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgHomeNormal"

                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:contentDescription="Trang chủ"

                    android:src="@drawable/ic_house"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- THÔNG BÁO -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/navNotification"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgNotification"

                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:contentDescription="Thông báo"

                    android:src="@drawable/ic_bell"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- NHÓM -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/navGroup"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgGroup"

                    android:layout_width="29dp"
                    android:layout_height="29dp"

                    android:layout_gravity="center"

                    android:contentDescription="Nhóm"

                    android:src="@drawable/ic_users"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CÁ NHÂN -->
            <!-- ================================================= -->

            <FrameLayout
                android:id="@+id/navPerson"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1">

                <!-- Chừa khoảng trống cho icon nổi -->
                <Space
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:layout_gravity="top" />

                <!-- Chữ Cá nhân -->
                <TextView
                    android:id="@+id/tvPerson"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_gravity="center_horizontal|bottom"

                    android:layout_marginBottom="6dp"

                    android:text="Cá nhân"

                    android:textColor="#30377F"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- ===================================================== -->
    <!-- ICON CÁ NHÂN NỔI - LỚP TRÊN CÙNG -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/personFloating"

        android:layout_width="0dp"
        android:layout_height="70dp"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:elevation="100dp"
        android:translationZ="100dp"

        android:translationY="-29dp"

        app:layout_constraintWidth_percent="0.25"

        app:layout_constraintStart_toStartOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="@id/bottomNavigation"

        app:layout_constraintHorizontal_bias="1.0"

        app:layout_constraintBottom_toBottomOf="@id/bottomNavigation">


        <!-- ================================================= -->
        <!-- VÒNG NGOÀI -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="62dp"
            android:layout_height="62dp"

            android:layout_gravity="center"

            android:elevation="100dp"
            android:translationZ="100dp"

            app:cardBackgroundColor="#F3F5FC"
            app:cardCornerRadius="31dp"
            app:cardElevation="0dp"

            app:strokeColor="@android:color/transparent"
            app:strokeWidth="0dp">


            <!-- ============================================= -->
            <!-- VÒNG XANH -->
            <!-- ============================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="46dp"
                android:layout_height="46dp"

                android:layout_gravity="center"

                android:elevation="100dp"
                android:translationZ="100dp"

                app:cardBackgroundColor="#30377F"
                app:cardCornerRadius="23dp"
                app:cardElevation="12dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <!-- ICON USER -->
                <ImageView
                    android:id="@+id/imgPersonFloating"

                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:contentDescription="Cá nhân"

                    android:src="@drawable/ic_user"
                    app:tint="#FFFFFF" />

            </com.google.android.material.card.MaterialCardView>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>