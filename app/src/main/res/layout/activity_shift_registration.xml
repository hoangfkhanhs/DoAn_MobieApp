                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#FAFBFD"
                                app:cardCornerRadius="0dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E5E7EF"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                app:cardBackgroundColor="#FFFFFF"
                                app:cardCornerRadius="0dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#E5E7EF"
                                app:strokeWidth="1dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CHÚ THÍCH -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutChuThich"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:gravity="center"
                android:orientation="horizontal">


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="10dp"
                    android:layout_height="10dp"

                    app:cardBackgroundColor="#FF5C5C"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#F04F4F"
                    app:strokeWidth="1dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="5dp"

                    android:text="Lịch làm việc"

                    android:textColor="#777777"
                    android:textSize="9sp" />


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="10dp"
                    android:layout_height="10dp"

                    android:layout_marginStart="18dp"

                    app:cardBackgroundColor="#666DAA"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#59609C"
                    app:strokeWidth="1dp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="5dp"

                    android:text="Đã đăng ký"

                    android:textColor="#777777"
                    android:textSize="9sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- NÚT ĐĂNG KÝ -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDangKyLich"

                android:layout_width="match_parent"
                android:layout_height="52dp"

                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"

                android:text="Đăng ký lịch"

                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"

                app:backgroundTint="#30377F"
                app:cornerRadius="17dp"
                app:elevation="0dp"
                app:strokeColor="#252B6D"
                app:strokeWidth="1dp" />


        </LinearLayout>

    </ScrollView>
    <!-- ===================================================== -->
    <!-- THANH ĐIỀU HƯỚNG DƯỚI -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="9dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">


            <FrameLayout
                android:id="@+id/navHome"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgHomeNormal"

                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:contentDescription="Trang chủ"

                    android:src="@drawable/ic_house"
                    app:tint="#30377F" />

            </FrameLayout>

            <!-- ================================================= -->
            <!-- THÔNG BÁO -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:contentDescription="Thông báo"
                    android:src="@drawable/ic_bell"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- NHÓM -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgGroup"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:contentDescription="Nhóm"
                    android:src="@drawable/ic_users"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CÁ NHÂN -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgPerson"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cá nhân"
                    android:src="@drawable/ic_user"
                    app:tint="#30377F" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>