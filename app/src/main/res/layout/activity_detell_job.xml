<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FC">


    <!-- ================================================= -->
    <!-- NỘI DUNG CHÍNH -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:clipToPadding="false"
        android:fillViewport="true"

        android:paddingBottom="30dp"

        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- NÚT QUAY LẠI -->
            <!-- ================================================= -->
            <ImageButton
                android:id="@+id/btnQuayLai"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:background="@android:color/transparent"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#20265F" />


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTieuDeTrang"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="3dp"

                android:gravity="center"

                android:text="Chi tiết bài đăng"
                android:textColor="#30377F"
                android:textSize="23sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvMoTaTrang"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:gravity="center"

                android:text="Thông tin chi tiết công việc tuyển dụng"
                android:textColor="#777777"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- CARD THÔNG TIN CÔNG VIỆC -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThongTinCongViec"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">


                    <!-- ================================================= -->
                    <!-- TÊN CÔNG VIỆC -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/tvTenCongViec"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Nhân viên phục vụ"
                        android:textColor="#222222"
                        android:textSize="21sp"
                        android:textStyle="bold" />


                    <!-- ================================================= -->
                    <!-- TRẠNG THÁI -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/tvTrangThai"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:background="#E8F5E9"

                        android:paddingStart="11dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp"

                        android:text="Đang tuyển"
                        android:textColor="#2E7D32"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <!-- ================================================= -->
                    <!-- ĐƯỜNG KẺ -->
                    <!-- ================================================= -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="16dp"

                        android:background="#EEEEEE" />


                    <!-- ================================================= -->
                    <!-- MỨC LƯƠNG -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="16dp"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:text="Mức lương"
                            android:textColor="#777777"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/tvLuong"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="25.000đ / giờ"
                            android:textColor="#30377F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- ĐỊA ĐIỂM -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:text="Địa điểm"
                            android:textColor="#777777"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/tvDiaDiem"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:maxWidth="210dp"

                            android:gravity="end"

                            android:text="Thủ Dầu Một, Bình Dương"
                            android:textColor="#333333"
                            android:textSize="13sp" />

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- SỐ LƯỢNG -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:text="Số lượng cần tuyển"
                            android:textColor="#777777"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/tvSoLuong"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="3 người"
                            android:textColor="#333333"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>


                    <!-- ================================================= -->
                    <!-- NGÀY ĐĂNG -->
                    <!-- ================================================= -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="13dp"

                        android:gravity="center_vertical"
                        android:orientation="horizontal">


                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:text="Ngày đăng"
                            android:textColor="#777777"
                            android:textSize="13sp" />


                        <TextView
                            android:id="@+id/tvNgayDang"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="28/09/2026"
                            android:textColor="#555555"
                            android:textSize="13sp" />

                    </LinearLayout>


                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CARD MÔ TẢ CÔNG VIỆC -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMoTa"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">


                    <!-- TIÊU ĐỀ -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Mô tả công việc"
                        android:textColor="#30377F"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <!-- NỘI DUNG -->

                    <TextView
                        android:id="@+id/tvMoTaCongViec"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:lineSpacingExtra="4dp"

                        android:text="Phục vụ khách hàng, hỗ trợ công việc tại cửa hàng. Sắp xếp hàng hóa, giữ gìn vệ sinh khu vực làm việc và hỗ trợ các công việc khác theo yêu cầu."
                        android:textColor="#555555"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CARD YÊU CẦU CÔNG VIỆC -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardYeuCau"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">


                    <!-- TIÊU ĐỀ -->

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Yêu cầu công việc"
                        android:textColor="#30377F"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <!-- YÊU CẦU 1 -->

                    <TextView
                        android:id="@+id/tvYeuCau1"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="• Có trách nhiệm trong công việc"
                        android:textColor="#555555"
                        android:textSize="13sp" />


                    <!-- YÊU CẦU 2 -->

                    <TextView
                        android:id="@+id/tvYeuCau2"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="• Giao tiếp tốt với khách hàng"
                        android:textColor="#555555"
                        android:textSize="13sp" />


                    <!-- YÊU CẦU 3 -->

                    <TextView
                        android:id="@+id/tvYeuCau3"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="• Có thể làm việc theo ca"
                        android:textColor="#555555"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CARD NGƯỜI TUYỂN DỤNG -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNguoiTuyenDung"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="18dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Người tuyển dụng"
                        android:textColor="#30377F"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvTenNguoiTuyen"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Nguyễn Hoàng Khánh"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvThongTinNguoiTuyen"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="Nhà tuyển dụng"
                        android:textColor="#777777"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- NÚT CHỈNH SỬA -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChinhSua"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="Chỉnh sửa bài đăng"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#30377F"
                app:cornerRadius="15dp"
                app:elevation="3dp" />

            <!-- ================================================= -->
            <!-- NÚT XÓA -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnXoa"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="9dp"
                android:text="Xóa bài đăng"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="15dp"
                app:elevation="0dp"
                app:strokeColor="#D32F2F"
                app:strokeWidth="1dp" />


            <!-- ================================================= -->
            <!-- KHOẢNG TRỐNG CUỐI -->
            <!-- ================================================= -->

            <Space
                android:layout_width="0dp"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>