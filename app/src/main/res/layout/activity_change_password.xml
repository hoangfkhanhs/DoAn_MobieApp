<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FC"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- HEADER WAVE -->
    <ImageView
        android:id="@+id/imgWave"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/wave_top"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- LOGO SHIFTGO -->
    <LinearLayout
        android:id="@+id/layoutLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="224dp"
            android:layout_height="185dp"
            android:contentDescription="Logo SHIFTGO"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_shiftgo" />

    </LinearLayout>

    <!-- 6 Ô NHẬP OTP -->
    <LinearLayout
        android:id="@+id/layoutOTP"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="23dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="23dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="6"
        app:layout_constraintTop_toBottomOf="@id/imgWave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ô 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/otp1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="#CAD2DC"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/edtOTP1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Số 1"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textColor="#30377F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ô 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/otp2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="#CAD2DC"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/edtOTP2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Số 2"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textColor="#30377F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ô 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/otp3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="#CAD2DC"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/edtOTP3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Số 3"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textColor="#30377F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ô 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/otp4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="#CAD2DC"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/edtOTP4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Số 4"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textColor="#30377F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ô 5 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/otp5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="4dp"
            app:cardBackgroundColor="#CAD2DC"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/edtOTP5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Số 6"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textColor="#30377F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Ô 6 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/otp6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            app:cardBackgroundColor="#CAD2DC"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <EditText
                android:id="@+id/edtOTP6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="Số 6"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="1"
                android:padding="0dp"
                android:textColor="#30377F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:importantForAutofill="no" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- NÚT SĐT -->
    <!--        app:layout_constraintTop_toBottomOf="@id/layoutOTP" -->

    <!-- NÚT EMAIL -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSDT"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="348dp"
        android:layout_marginEnd="8dp"
        android:text="SĐT"
        android:textAllCaps="false"
        android:textColor="#30377F"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="15dp"
        app:layout_constraintEnd_toStartOf="@id/btnEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="1dp" />

    <!--        app:layout_constraintTop_toBottomOf="@id/layoutOTP" -->

    <!-- NÚT GỬI MÃ XÁC NHẬN -->
    <!-- THANH ĐIỀU HƯỚNG -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmail"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:text="Email"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="#5059B8"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSDT"
        app:layout_constraintTop_toTopOf="@id/btnSDT"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="#30377F" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuiMa"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="38dp"
        android:layout_marginEnd="38dp"
        android:layout_marginBottom="244dp"
        android:text="Gửi mã xác nhận"
        android:textAllCaps="false"
        android:textColor="#30377F"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#30377F"
        app:strokeWidth="1dp" />
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="9dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="5dp"
        app:strokeWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- TRANG CHỦ -->
            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Trang chủ">

                <ImageView
                    android:id="@+id/imgHomeNormal"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_house"
                    app:tint="#30377F" />
            </FrameLayout>

            <!-- THÔNG BÁO -->
            <FrameLayout
                android:id="@+id/navNotification"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Thông báo">

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell"
                    app:tint="#30377F" />
            </FrameLayout>

            <!-- NHÓM -->
            <FrameLayout
                android:id="@+id/navGroup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Nhóm">

                <ImageView
                    android:id="@+id/imgGroup"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_users"
                    app:tint="#30377F" />
            </FrameLayout>

            <!-- CÁ NHÂN -->
            <FrameLayout
                android:id="@+id/navPerson"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Cá nhân">

                <TextView
                    android:id="@+id/tvPerson"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="6dp"
                    android:text="Cá nhân"
                    android:textColor="#30377F"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ICON CÁ NHÂN NỔI -->
    <FrameLayout
        android:id="@+id/personFloating"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:contentDescription="Mở trang cá nhân"
        android:elevation="20dp"
        android:translationY="-29dp"
        app:layout_constraintWidth_percent="0.25"
        app:layout_constraintStart_toStartOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="@id/bottomNavigation"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintBottom_toBottomOf="@id/bottomNavigation">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#F3F5FC"
            app:cardCornerRadius="31dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#30377F"
                app:cardCornerRadius="23dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/imgPersonFloating"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_user"
                    app:tint="#FFFFFF" />

            </com.google.android.material.card.MaterialCardView>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>