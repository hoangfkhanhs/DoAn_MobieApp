<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FC">

    <!-- NỘI DUNG CHÍNH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="25dp"
        android:paddingEnd="20dp"
        android:paddingBottom="78dp">

        <!-- TIÊU ĐỀ -->
        <TextView
            android:id="@+id/tvTieuDe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Quản lý tuyển dụng"
            android:textColor="#30377F"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMoTa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Quản lý các bài đăng tuyển dụng của bạn"
            android:textColor="#777777"
            android:textSize="12sp" />

        <!-- BỘ LỌC -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTatCa"
                    android:layout_width="90dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:text="Tất cả"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:backgroundTint="#30377F"
                    app:cornerRadius="20dp"
                    app:elevation="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDangTuyen"
                    android:layout_width="105dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:text="Đang tuyển"
                    android:textAllCaps="false"
                    android:textColor="#30377F"
                    android:textSize="12sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"
                    app:elevation="0dp"
                    app:strokeColor="#30377F"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDaDong"
                    android:layout_width="95dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:text="Đã đóng"
                    android:textAllCaps="false"
                    android:textColor="#30377F"
                    android:textSize="12sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="20dp"
                    app:elevation="0dp"
                    app:strokeColor="#30377F"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnThemCongViec"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:padding="0dp"
                    android:contentDescription="Thêm công việc"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="normal"
                    app:backgroundTint="#30377F"
                    app:cornerRadius="24dp"
                    app:elevation="0dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- TIÊU ĐỀ DANH SÁCH -->
        <TextView
            android:id="@+id/tvSoLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Bài đăng của bạn"
            android:textColor="#30377F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- DANH SÁCH CUỘN -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDanhSach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- BÀI ĐĂNG 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCongViec1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvTenCongViec1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nhân viên phục vụ"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrangThai1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:background="#E8F5E9"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Đang tuyển"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLuong1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="25.000đ / giờ"
                            android:textColor="#444444"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDiaDiem1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Thủ Dầu Một, Bình Dương"
                            android:textColor="#555555"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvNgayDang1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Ngày đăng: 28/09/2026"
                            android:textColor="#888888"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="10dp"
                            android:background="#EEEEEE" />

                        <!-- CÁC NÚT BÀI ĐĂNG 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSua1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:text="Sửa"
                                android:textAllCaps="false"
                                android:textColor="#30377F"
                                android:textSize="12sp"
                                app:backgroundTint="#FFFFFF"
                                app:cornerRadius="12dp"
                                app:elevation="0dp"
                                app:strokeColor="#30377F"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnXoa1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:text="Xóa"
                                android:textAllCaps="false"
                                android:textColor="#D32F2F"
                                android:textSize="12sp"
                                app:backgroundTint="#FFFFFF"
                                app:cornerRadius="12dp"
                                app:elevation="0dp"
                                app:strokeColor="#D32F2F"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUngVien1"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:text="Ứng viên"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                app:backgroundTint="#30377F"
                                app:cornerRadius="12dp"
                                app:elevation="0dp" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- BÀI ĐĂNG 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCongViec2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvTenCongViec2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Nhân viên bán hàng"
                            android:textColor="#222222"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrangThai2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:background="#EEEEEE"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="Đã đóng"
                            android:textColor="#666666"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLuong2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="30.000đ / giờ"
                            android:textColor="#444444"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDiaDiem2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Bình Dương"
                            android:textColor="#555555"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvNgayDang2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Ngày đăng: 20/09/2026"
                            android:textColor="#888888"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="13dp"
                            android:layout_marginBottom="10dp"
                            android:background="#EEEEEE" />

                        <!-- CÁC NÚT BÀI ĐĂNG 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSua2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:text="Sửa"
                                android:textAllCaps="false"
                                android:textColor="#30377F"
                                android:textSize="12sp"
                                app:backgroundTint="#FFFFFF"
                                app:cornerRadius="12dp"
                                app:elevation="0dp"
                                app:strokeColor="#30377F"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnXoa2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:text="Xóa"
                                android:textAllCaps="false"
                                android:textColor="#D32F2F"
                                android:textSize="12sp"
                                app:backgroundTint="#FFFFFF"
                                app:cornerRadius="12dp"
                                app:elevation="0dp"
                                app:strokeColor="#D32F2F"
                                app:strokeWidth="1dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUngVien2"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:minHeight="48dp"
                                android:text="Ứng viên"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                app:backgroundTint="#30377F"
                                app:cornerRadius="12dp"
                                app:elevation="0dp" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="9dp"
        android:elevation="20dp"
        android:translationZ="20dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="4dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- TRANG CHỦ -->
            <FrameLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Trang chủ">

                <ImageView
                    android:id="@+id/imgHomeNormal"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_house"
                    app:tint="#30377F" />
            </FrameLayout>

            <!-- THÔNG BÁO -->
            <FrameLayout
                android:id="@+id/navNotification"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Thông báo">

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bell"
                    app:tint="#30377F" />
            </FrameLayout>

            <!-- NHÓM -->
            <FrameLayout
                android:id="@+id/navGroup"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Nhóm">

                <ImageView
                    android:id="@+id/imgGroup"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_users"
                    app:tint="#30377F" />
            </FrameLayout>

            <!-- CÁ NHÂN -->
            <FrameLayout
                android:id="@+id/navPerson"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Cá nhân">

                <ImageView
                    android:id="@+id/imgPerson"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_user"
                    app:tint="#30377F" />
            </FrameLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>