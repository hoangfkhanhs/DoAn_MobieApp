<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FC">


    <!-- ================================================= -->
    <!-- NỘI DUNG -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:fillViewport="true"
        android:clipToPadding="false"

        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- NÚT QUAY LẠI -->
            <!-- ================================================= -->
            <ImageButton
                android:id="@+id/btnQuayLai"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#20265F" />


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTieuDe"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:text="Thông tin ứng viên"
                android:textColor="#30377F"
                android:textSize="23sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvMoTa"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:gravity="center"

                android:text="Thông tin chi tiết của ứng viên ứng tuyển"
                android:textColor="#777777"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- THÔNG TIN CÁ NHÂN -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThongTinCaNhan"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">


                    <!-- ================================================= -->
                    <!-- TÊN -->
                    <!-- ================================================= -->

                    <TextView
                        android:id="@+id/tvTenUngVien"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Nguyễn Hoàng Khánh"
                        android:textColor="#222222"
                        android:textSize="20sp"
                        android:textStyle="bold" />


                    <!-- EMAIL -->

                    <TextView
                        android:id="@+id/tvEmail"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:text="Email: khanh@gmail.com"
                        android:textColor="#555555"
                        android:textSize="13sp" />


                    <!-- SỐ ĐIỆN THOẠI -->

                    <TextView
                        android:id="@+id/tvSoDienThoai"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Số điện thoại: 0901234567"
                        android:textColor="#555555"
                        android:textSize="13sp" />


                    <!-- KHU VỰC -->

                    <TextView
                        android:id="@+id/tvKhuVuc"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Khu vực làm việc: Thủ Dầu Một, Bình Dương"
                        android:textColor="#555555"
                        android:textSize="13sp" />


                    <!-- ================================================= -->
                    <!-- TRẠNG THÁI -->
                    <!-- ================================================= -->
                    <TextView
                        android:id="@+id/tvTrangThai"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#FFF3E0"
                        android:paddingStart="11dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="11dp"
                        android:paddingBottom="5dp"
                        android:text="Đang chờ"
                        android:textColor="#8A3D00"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- THÔNG TIN LÀM VIỆC -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThongTinLamViec"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp"/>


            <!-- ================================================= -->
            <!-- GIỚI THIỆU -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGioiThieu"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Giới thiệu bản thân"
                        android:textColor="#30377F"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvGioiThieu"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:lineSpacingExtra="3dp"

                        android:text="Tôi là sinh viên ngành Công nghệ thông tin, có kinh nghiệm phát triển website và mong muốn tìm kiếm môi trường làm việc phù hợp để phát triển kỹ năng."
                        android:textColor="#555555"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- THÔNG TIN ỨNG TUYỂN -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThongTinUngTuyen"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Thông tin ứng tuyển"
                        android:textColor="#30377F"
                        android:textSize="16sp"
                        android:textStyle="bold" />


                    <!-- CÔNG VIỆC -->

                    <TextView
                        android:id="@+id/tvCongViecUngTuyen"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:text="Công việc: Nhân viên phục vụ"
                        android:textColor="#444444"
                        android:textSize="13sp" />


                    <!-- NGÀY ỨNG TUYỂN -->

                    <TextView
                        android:id="@+id/tvNgayUngTuyen"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Ngày ứng tuyển: 28/09/2026"
                        android:textColor="#444444"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- CV -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCV"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp"/>


            <!-- ================================================= -->
            <!-- NÚT DUYỆT / TỪ CHỐI -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:orientation="horizontal">


                <!-- TỪ CHỐI -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTuChoi"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="Từ chối"
                    android:textAllCaps="false"
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="15dp"
                    app:elevation="0dp"
                    app:strokeColor="#D32F2F"
                    app:strokeWidth="1dp" />

                <!-- DUYỆT -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDuyet"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="Duyệt ứng viên"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E7D32"
                    app:cornerRadius="15dp"
                    app:elevation="2dp" />
            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</FrameLayout>