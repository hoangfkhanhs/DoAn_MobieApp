<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F3F5FC"

    android:clipChildren="false"
    android:clipToPadding="false">


    <!-- ===================================================== -->
    <!-- NỘI DUNG -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollThongKe"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:fillViewport="true"

        android:clipToPadding="false"

        android:paddingBottom="90dp"

        android:scrollbars="none"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <LinearLayout
            android:id="@+id/layoutThongKe"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="7dp"
            android:paddingTop="7dp"
            android:paddingEnd="7dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- PHẦN THÔNG TIN NGƯỜI DÙNG -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThongTin"

                android:layout_width="match_parent"
                android:layout_height="120dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- ========================================= -->
                    <!-- AVATAR -->
                    <!-- ========================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAvatar"

                        android:layout_width="94dp"
                        android:layout_height="94dp"

                        android:layout_marginStart="10dp"
                        android:layout_marginTop="10dp"

                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="47dp"
                        app:cardElevation="0dp"

                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="4dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:background="#DDF3FF">


                            <!-- Có thể thay bằng ảnh avatar sau -->

                            <TextView
                                android:id="@+id/tvAvatarIcon"

                                android:layout_width="match_parent"
                                android:layout_height="match_parent"

                                android:gravity="center"
                                android:textColor="#FFFFFF"
                                android:textSize="38sp"

                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- ========================================= -->
                    <!-- THÔNG TIN -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:id="@+id/layoutThongTin"

                        android:layout_width="0dp"
                        android:layout_height="wrap_content"

                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="10dp"

                        android:orientation="vertical"

                        app:layout_constraintStart_toEndOf="@id/cardAvatar"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/cardAvatar"
                        app:layout_constraintBottom_toBottomOf="@id/cardAvatar">


                        <!-- Công việc đang tham gia -->

                        <TextView
                            android:id="@+id/tvCongViecThamGia"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:text="Công việc đang tham gia: 3"

                            android:textColor="#30377F"
                            android:textSize="12sp"
                            android:textStyle="bold" />


                        <!-- Công việc đã nghỉ -->

                        <TextView
                            android:id="@+id/tvCongViecDaNghi"

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"

                            android:layout_marginTop="7dp"

                            android:text="Công việc đã nghỉ: 2"

                            android:textColor="#30377F"
                            android:textSize="12sp"
                            android:textStyle="bold" />


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- KHOẢNG CÁCH -->
            <!-- ================================================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="10dp" />


            <!-- ================================================= -->
            <!-- CARD BIỂU ĐỒ 1 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBieuDo1"

                android:layout_width="match_parent"
                android:layout_height="164dp"

                app:cardBackgroundColor="#30377F"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- ========================================= -->
                    <!-- KHU VỰC BIỂU ĐỒ TRỐNG -->
                    <!-- ========================================= -->

                    <LinearLayout
                        android:id="@+id/chartContainer1"

                        android:layout_width="match_parent"
                        android:layout_height="115dp"

                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="8dp"

                        android:gravity="center"

                        android:orientation="horizontal"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <!-- Vùng trống 1 -->

                        <View
                            android:id="@+id/chartEmpty1"

                            android:layout_width="0dp"
                            android:layout_height="90dp"

                            android:layout_weight="1"

                            android:background="@android:color/transparent" />


                        <!-- Vùng trống 2 -->

                        <View
                            android:id="@+id/chartEmpty2"

                            android:layout_width="0dp"
                            android:layout_height="90dp"

                            android:layout_weight="1"

                            android:background="@android:color/transparent" />


                        <!-- Vùng trống 3 -->

                        <View
                            android:id="@+id/chartEmpty3"

                            android:layout_width="0dp"
                            android:layout_height="90dp"

                            android:layout_weight="1"

                            android:background="@android:color/transparent" />


                    </LinearLayout>


                    <!-- ========================================= -->
                    <!-- TIÊU ĐỀ -->
                    <!-- ========================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/titleChart1"

                        android:layout_width="0dp"
                        android:layout_height="36dp"

                        android:layout_marginStart="25dp"
                        android:layout_marginEnd="25dp"

                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <TextView
                            android:id="@+id/tvTitleChart1"

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:text="Số ngày làm việc trong tuần"

                            android:textColor="#30377F"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- KHOẢNG CÁCH -->
            <!-- ================================================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />


            <!-- ================================================= -->
            <!-- CARD BIỂU ĐỒ 2 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBieuDo2"

                android:layout_width="match_parent"
                android:layout_height="164dp"

                app:cardBackgroundColor="#3C4695"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- ========================================= -->
                    <!-- VÙNG BIỂU ĐỒ TRỐNG -->
                    <!-- ========================================= -->

                    <FrameLayout
                        android:id="@+id/chartContainer2"

                        android:layout_width="match_parent"
                        android:layout_height="115dp"

                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="7dp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <!--

                        ĐỂ TRỐNG

                        Sau này có thể đặt:
                        LineChart
                        BarChart
                        hoặc custom View

                        -->

                    </FrameLayout>


                    <!-- ========================================= -->
                    <!-- TIÊU ĐỀ -->
                    <!-- ========================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/titleChart2"

                        android:layout_width="0dp"
                        android:layout_height="36dp"

                        android:layout_marginStart="25dp"
                        android:layout_marginEnd="25dp"

                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <TextView
                            android:id="@+id/tvTitleChart2"

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:text="Tần suất làm việc trong tuần"

                            android:textColor="#30377F"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- KHOẢNG CÁCH -->
            <!-- ================================================= -->

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />


            <!-- ================================================= -->
            <!-- CARD BIỂU ĐỒ 3 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBieuDo3"

                android:layout_width="match_parent"
                android:layout_height="164dp"

                app:cardBackgroundColor="#30377F"
                app:cardCornerRadius="17dp"
                app:cardElevation="0dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <!-- ========================================= -->
                    <!-- VÙNG BIỂU ĐỒ TRỐNG -->
                    <!-- ========================================= -->

                    <FrameLayout
                        android:id="@+id/chartContainer3"

                        android:layout_width="match_parent"
                        android:layout_height="115dp"

                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="7dp"

                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">


                        <!-- Để trống để thêm biểu đồ sau -->


                    </FrameLayout>


                    <!-- ========================================= -->
                    <!-- TIÊU ĐỀ -->
                    <!-- ========================================= -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/titleChart3"

                        android:layout_width="0dp"
                        android:layout_height="36dp"

                        android:layout_marginStart="25dp"
                        android:layout_marginEnd="25dp"

                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"

                        app:strokeColor="@android:color/transparent"
                        app:strokeWidth="0dp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">


                        <TextView
                            android:id="@+id/tvTitleChart3"

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"

                            android:gravity="center"

                            android:text="Thống kê công việc"

                            android:textColor="#30377F"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>

    <!-- ===================================================== -->
    <!-- THANH ĐIỀU HƯỚNG DƯỚI -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="11dp"
        android:layout_marginBottom="9dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="4">


            <FrameLayout
                android:id="@+id/navHome"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgHomeNormal"

                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:layout_gravity="center"

                    android:contentDescription="Trang chủ"

                    android:src="@drawable/ic_house"
                    app:tint="#30377F" />

            </FrameLayout>

            <!-- ================================================= -->
            <!-- THÔNG BÁO -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgNotification"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:contentDescription="Thông báo"
                    android:src="@drawable/ic_bell"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- NHÓM -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgGroup"
                    android:layout_width="29dp"
                    android:layout_height="29dp"
                    android:layout_gravity="center"
                    android:contentDescription="Nhóm"
                    android:src="@drawable/ic_users"
                    app:tint="#30377F" />

            </FrameLayout>


            <!-- ================================================= -->
            <!-- CÁ NHÂN -->
            <!-- ================================================= -->

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgPerson"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:contentDescription="Cá nhân"
                    android:src="@drawable/ic_user"
                    app:tint="#30377F" />

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>