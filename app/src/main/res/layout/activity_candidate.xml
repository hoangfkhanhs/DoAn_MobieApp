<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FC">


    <!-- ================================================= -->
    <!-- NỘI DUNG -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="20dp"
        android:scrollbars="none">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="25dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">


            <!-- ================================================= -->
            <!-- NÚT QUAY LẠI -->
            <!-- ================================================= -->
            <ImageButton
                android:id="@+id/btnQuayLai"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:background="@android:color/transparent"
                android:contentDescription="Quay lại"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#20265F" />


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTieuDe"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:text="Duyệt ứng viên"
                android:textColor="#30377F"
                android:textSize="23sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvMoTa"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"

                android:gravity="center"

                android:text="Xem và xử lý các ứng viên đăng ký công việc"
                android:textColor="#777777"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- THÔNG TIN JOB -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardThongTinCongViec"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                app:cardBackgroundColor="#30377F"
                app:cardCornerRadius="17dp"
                app:cardElevation="2dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="17dp">


                    <!-- TÊN JOB -->

                    <TextView
                        android:id="@+id/tvTenCongViec"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Nhân viên phục vụ"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <!-- ĐỊA ĐIỂM -->

                    <TextView
                        android:id="@+id/tvDiaDiem"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Thủ Dầu Một, Bình Dương"
                        android:textColor="#E8E9FF"
                        android:textSize="12sp" />


                    <!-- LƯƠNG -->

                    <TextView
                        android:id="@+id/tvLuong"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="25.000đ / giờ"
                        android:textColor="#E8E9FF"
                        android:textSize="12sp" />


                    <!-- SỐ ỨNG VIÊN -->

                    <TextView
                        android:id="@+id/tvSoLuongUngVien"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Có 3 ứng viên đăng ký"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ DANH SÁCH -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTieuDeDanhSach"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:text="Danh sách ứng viên"
                android:textColor="#30377F"
                android:textSize="16sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- ỨNG VIÊN 1 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUngVien1"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="16dp">


                    <!-- TÊN ỨNG VIÊN -->

                    <TextView
                        android:id="@+id/tvTenUngVien1"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Nguyễn Hoàng Khánh"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold" />


                    <!-- CHUYÊN NGÀNH -->

                    <TextView
                        android:id="@+id/tvChuyenNganh1"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Lập trình Web"
                        android:textColor="#555555"
                        android:textSize="12sp" />


                    <!-- HÌNH THỨC -->

                    <TextView
                        android:id="@+id/tvHinhThuc1"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="Toàn thời gian"
                        android:textColor="#555555"
                        android:textSize="12sp" />


                    <!-- TRẠNG THÁI -->

                    <TextView
                        android:id="@+id/tvTrangThai1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="#FFF3E0"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Đang chờ"
                        android:textColor="#9A3412"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <!-- NGÀY ỨNG TUYỂN -->

                    <TextView
                        android:id="@+id/tvNgayUngTuyen1"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Ngày ứng tuyển: 28/09/2026"
                        android:textColor="#888888"
                        android:textSize="11sp" />


                    <!-- ĐƯỜNG KẺ -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="10dp"

                        android:background="#EEEEEE" />


                    <!-- NÚT -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">


                        <!-- XEM HỒ SƠ -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnXemHoSo1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="Xem hồ sơ"
                            android:textAllCaps="false"
                            android:textColor="#30377F"
                            android:textSize="11sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"
                            app:strokeColor="#30377F"
                            app:strokeWidth="1dp"/>
<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->



                        <!-- DUYỆT -->

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuyet1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="Duyệt"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"/>
<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->


                        <!-- TỪ CHỐI -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTuChoi1"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="Từ chối"
                            android:textAllCaps="false"
                            android:textColor="#D32F2F"
                            android:textSize="11sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"
                            app:strokeColor="#D32F2F"
                            app:strokeWidth="1dp"/>
<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- ỨNG VIÊN 2 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUngVien2"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="16dp">


                    <TextView
                        android:id="@+id/tvTenUngVien2"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Trần Văn Minh"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvChuyenNganh2"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Thiết kế đồ họa"
                        android:textColor="#555555"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/tvHinhThuc2"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="Bán thời gian"
                        android:textColor="#555555"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/tvTrangThai2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="#FFF3E0"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="Đang chờ"
                        android:textColor="#9A3412"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvNgayUngTuyen2"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Ngày ứng tuyển: 27/09/2026"
                        android:textColor="#888888"
                        android:textSize="11sp" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="10dp"

                        android:background="#EEEEEE" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnXemHoSo2"

                            android:layout_width="0dp"
                            android:layout_height="42dp"

                            android:layout_weight="1"

                            android:minWidth="0dp"

                            android:text="Xem hồ sơ"
                            android:textAllCaps="false"
                            android:textColor="#30377F"
                            android:textSize="11sp"

                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"

                            app:strokeColor="#30377F"
                            app:strokeWidth="1dp"/>

<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuyet2"

                            android:layout_width="0dp"
                            android:layout_height="42dp"

                            android:layout_marginStart="8dp"

                            android:layout_weight="1"

                            android:minWidth="0dp"

                            android:text="Duyệt"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"

                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"/>

<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTuChoi2"

                            android:layout_width="0dp"
                            android:layout_height="42dp"

                            android:layout_marginStart="8dp"

                            android:layout_weight="1"

                            android:minWidth="0dp"

                            android:text="Từ chối"
                            android:textAllCaps="false"
                            android:textColor="#D32F2F"
                            android:textSize="11sp"

                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"

                            app:strokeColor="#D32F2F"
                            app:strokeWidth="1dp"/>

<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- ================================================= -->
            <!-- ỨNG VIÊN 3 -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUngVien3"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginBottom="10dp"

                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="17dp"
                app:cardElevation="1dp"

                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:padding="16dp">


                    <TextView
                        android:id="@+id/tvTenUngVien3"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="Lê Thị Ngọc"
                        android:textColor="#222222"
                        android:textSize="17sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvChuyenNganh3"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="7dp"

                        android:text="Marketing"
                        android:textColor="#555555"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/tvHinhThuc3"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:text="Bán thời gian"
                        android:textColor="#555555"
                        android:textSize="12sp" />


                    <TextView
                        android:id="@+id/tvTrangThai3"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:background="#FFF3E0"

                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"

                        android:text="Đang chờ"
                        android:textColor="#EF6C00"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <TextView
                        android:id="@+id/tvNgayUngTuyen3"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:text="Ngày ứng tuyển: 26/09/2026"
                        android:textColor="#888888"
                        android:textSize="11sp" />


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"

                        android:layout_marginTop="13dp"
                        android:layout_marginBottom="10dp"

                        android:background="#EEEEEE" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnXemHoSo3"

                            android:layout_width="0dp"
                            android:layout_height="42dp"

                            android:layout_weight="1"

                            android:minWidth="0dp"

                            android:text="Xem hồ sơ"
                            android:textAllCaps="false"
                            android:textColor="#30377F"
                            android:textSize="11sp"

                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"

                            app:strokeColor="#30377F"
                            app:strokeWidth="1dp" />

<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp"-->


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDuyet3"

                            android:layout_width="0dp"
                            android:layout_height="42dp"

                            android:layout_marginStart="8dp"

                            android:layout_weight="1"

                            android:minWidth="0dp"

                            android:text="Duyệt"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"

                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"/>

<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTuChoi3"

                            android:layout_width="0dp"
                            android:layout_height="42dp"

                            android:layout_marginStart="8dp"

                            android:layout_weight="1"

                            android:minWidth="0dp"

                            android:text="Từ chối"
                            android:textAllCaps="false"
                            android:textColor="#D32F2F"
                            android:textSize="11sp"

                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"

                            app:strokeColor="#D32F2F"
                            app:strokeWidth="1dp"/>

<!--                            app:insetTop="0dp"-->
<!--                            app:insetBottom="0dp" -->

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>

</FrameLayout>